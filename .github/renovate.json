{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessagePrefix": "🚀",
  "configMigration": true,
  "dependencyDashboard": {
    "enabled": false
  },
  "labels": ["dependencies", "no-stale"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "extends": ["config:recommended"],
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchManagers": ["ansible-galaxy"],
      "enabled": true
    }
  ]
}
